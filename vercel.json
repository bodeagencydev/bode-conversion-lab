{
  "redirects": [
    { "source": "/case-studies", "destination": "/past-projects", "permanent": true },
    { "source": "/case-studies/:id", "destination": "/past-projects/:id", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    { "path": "/api/cron/weekly-digest", "schedule": "0 14 * * 1" }
  ]
}
